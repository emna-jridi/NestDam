# ==========================================
# ShadowGuard Backend - Environment Variables
# ==========================================

# Database Configuration
MONGODB_URI=mongodb://localhost:27017/shadowguard
REDIS_HOST=localhost
REDIS_PORT=6379

# Ollama AI Service
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.2
OLLAMA_TIMEOUT=60000

# External Services (Optional)
MOBSF_HOST=http://localhost:8000
MOBSF_API_KEY=your_mobsf_api_key_here

# Application Settings
PORT=3000
NODE_ENV=development

# JWT Configuration
JWT_SECRET=your_jwt_secret_here_change_in_production
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=change-me-to-a-long-random-string

# CORS Settings
CORS_ORIGIN=*

# Rate Limiting
RATE_LIMIT_TTL=60
RATE_LIMIT_LIMIT=100

# Logging
LOG_LEVEL=debug

# Email (SMTP) - SendGrid by default; for Gmail use MAIL_HOST=smtp.gmail.com, MAIL_PORT=465, MAIL_USER=<gmail address>, MAIL_PASS=<app password>
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USER=apikey
MAIL_PASS=
MAIL_FROM=shadowguardnoreplay@gmail.com

# Python used by the FAST ML scan (needs ml/requirements.txt)
PYTHON_BIN=python

# Gemini model for scan explanations (default: gemini-flash-latest)
GEMINI_MODEL=gemini-flash-latest
