# Example environment variables for NestDam


# Application
NODE_ENV=development
PORT=3000

# MongoDB connection 
MONGO_URI=mongodb://localhost:27017/shadowdb

# JWT configuration
# Change the secret before production
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=15m

# SendGrid (used by MailService)
# Provide your SendGrid API key here
SENDGRID_API_KEY=your-sendgrid-api-key

# MobSF API 
# URL of MobSF instance and API key
MOBSF_URL=http://localhost:8000
MOBSF_API_KEY=your-mobsf-api-key

# Additional tips:
# - Keep `.env` out of git. Use `.env.example` to document required keys.
# - For CI, set these vars in your pipeline's secret store.

# Refresh token configuration
REFRESH_TOKEN_SECRET=your-refresh-secret-change-in-production
REFRESH_EXPIRES_IN=7d
