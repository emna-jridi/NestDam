# ---------------------------
# Environment Configuration
# ---------------------------
NODE_ENV=development
PORT=5001

# ---------------------------
# API Metadata
# ---------------------------
API_TITLE=NestDam API
API_DESCRIPTION=API documentation for NestDam application
API_VERSION=1.0.0

# ---------------------------
# Database Configuration
# ---------------------------
# Example local MongoDB connection string
MONGO_URI=mongodb://<username>:<password>@127.0.0.1:27017/<database>?authSource=admin

# ---------------------------
# JWT Configuration
# ---------------------------
JWT_SECRET=your-jwt-secret
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your-refresh-secret
REFRESH_EXPIRES_IN=7d

# ---------------------------
# Mailtrap or SendGrid Configuration
# ---------------------------
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USER=your-mailtrap-username
MAIL_PASSWORD=<your-mailtrap-password
MAIL_SECURE=false
MAIL_FROM=your-email@example.com

# SendGrid (optional)
SENDGRID_API_KEY=your-sendgrid-api-key

# ---------------------------
# MobSF Configuration
# ---------------------------
MOBSF_URL=http://localhost:8000
MOBSF_API_KEY=your-mobsf-api-key
