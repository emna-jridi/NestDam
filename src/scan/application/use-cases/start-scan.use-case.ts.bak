import { Injectable, Logger, BadRequestException } from '@nestjs/common';
import { Types } from 'mongoose';
import { StartScanRequestDto } from '../../domain/dtos/start-scan.dto';
import { ScanResponseDto } from '../../domain/dtos/scan-response.dto';
import { AnalysisResultDto } from '../../domain/dtos/analysis-result.dto';
import { ScoreCalculatorService } from '../../domain/services/score-calculator.service';
import { OllamaService } from '../../infrastructure/external-services/ollama.service';
import { PlayStoreService } from '../../infrastructure/external-services/play-store.service';
import { CacheService } from '../../infrastructure/cache/cache.service';
import { ScanRepository } from '../../infrastructure/repositories/scan.repository';
import { AppRepository } from '../../infrastructure/repositories/app.repository';
import { ScanEntity } from '../../domain/entities/scan.entity';

@Injectable()
export class StartScanUseCase {
  private logger = new Logger(StartScanUseCase.name);

  constructor(
    private scanRepository: ScanRepository,
    private appRepository: AppRepository,
    private scoreCalculator: ScoreCalculatorService,
    private ollamaService: OllamaService,
    private playStoreService: PlayStoreService,
    private cacheService: CacheService,
  ) {}

  async execute(request: StartScanRequestDto): Promise<ScanResponseDto> {
    const startTime = Date.now();

    this.logger.debug(`[EXECUTE] 📥 Full request:`, JSON.stringify(request).substring(0, 400));

    if (!request.apps || request.apps.length === 0) {
      throw new BadRequestException('At least one app package name is required');
    }

    const apps = request.apps as any[];
    // Use MongoDB ObjectId instead of UUID
    const scanId = new Types.ObjectId().toString();

    this.logger.log(`[${scanId}] 🚀 Starting scan for ${apps.length} apps`);
    this.logger.debug(`[${scanId}] 📦 Apps array contains:`, JSON.stringify(apps));

    try {
      // Créer le scan en BD avec status 'pending'
      const scan: ScanEntity = {
        id: scanId,
        userId: request.userId,
        deviceId: request.deviceId,
        platform: request.platform,
        status: 'pending',
        apps: [],
        createdAt: new Date(),
        totalApps: apps.length,
        scannedApps: 0,
      };

      const savedScan = await this.scanRepository.save(scan);
      const finalScanId = savedScan.id || scanId;
      this.logger.log(`[${finalScanId}] ✅ Scan created in database`);

      // RETOURNER IMMÉDIATEMENT avec scanId (pas d'attente)
      const response: ScanResponseDto = {
        scanId: finalScanId,
        status: 'pending',
        userId: request.userId,
        deviceId: request.deviceId,
        platform: request.platform,
        createdAt: new Date().toISOString(),
      };

      // Lancer l'analyse EN ARRIÈRE-PLAN (async, sans attendre)
      this.performAsyncAnalysis(finalScanId, apps, request.userId, request.deviceId);

      return response;
    } catch (error: any) {
      this.logger.error(`[${scanId}] ❌ Scan creation failed: ${error.message}`);
      throw error;
    }
  }

  /**
   * Effectuer l'analyse de manière asynchrone (sans bloquer)
   * Cette méthode ne bloque pas le retour de execute()
   */
  private performAsyncAnalysis(
    scanId: string,
    apps: any[],
    userId: string,
    deviceId: string,
  ): void {
    this.logger.log(`[${scanId}] 📤 performAsyncAnalysis CALLED - apps: ${apps.length}`);
    
    // Fire and forget - pas d'attente
    setImmediate(async () => {
      const analysisStartTime = Date.now();
      this.logger.log(`[${scanId}] ⏱️ setImmediate STARTED at ${new Date().toISOString()}`);
      
      try {
        this.logger.log(`[${scanId}] 📝 Step 1: Updating status to 'analyzing'...`);

        // Mettre à jour status à 'analyzing'
        const updateResult = await this.scanRepository.update(scanId, {
          status: 'analyzing',
        });
        this.logger.log(`[${scanId}] ✅ Step 1 DONE - Update result: ${updateResult ? 'success' : 'failed'}`);

        const results: AnalysisResultDto[] = [];
        let scannedCount = 0;

        this.logger.log(`[${scanId}] 🔍 Step 2: Starting analysis of ${apps.length} apps...`);

        // Analyser chaque app
        for (let i = 0; i < apps.length; i++) {
          const app = apps[i];
          const packageName = typeof app === 'string' ? app : app.packageName;
          this.logger.log(`[${scanId}] 📱 [${i + 1}/${apps.length}] Analyzing: ${packageName}`);
          
          try {
            const appStartTime = Date.now();
            const result = await this.scanApp(packageName);
            const appDuration = Date.now() - appStartTime;
            
            results.push(result);
            scannedCount++;

            // Mettre à jour le count d'apps scannées
            await this.scanRepository.update(scanId, {
              scannedApps: scannedCount,
            });

            this.logger.log(`[${scanId}] ✅ [${i + 1}/${apps.length}] ${packageName} DONE in ${appDuration}ms`);
          } catch (error: any) {
            this.logger.error(`[${scanId}] ❌ [${i + 1}/${apps.length}] ${packageName} FAILED: ${error.message}`);
            this.logger.error(`[${scanId}] Stack: ${error.stack}`);
            // Continuer avec les autres apps malgré l'erreur
          }
        }

        this.logger.log(`[${scanId}] 📊 Step 3: Calculating global statistics...`);

        // Calculer les statistiques globales
        const aggregated = this.scoreCalculator.aggregateResults(results);

        // Calculer la durée totale
        const duration = Date.now() - analysisStartTime;
        
        this.logger.log(`[${scanId}] 💾 Step 4: Saving final results...`);

        // Mettre à jour le scan avec le statut final
        await this.scanRepository.update(scanId, {
          status: 'completed',
          completedAt: new Date(),
          duration: duration,
          results: {
            apps: results as any, // Type conversion accepted
            globalSummary: aggregated.globalSummary,
            globalRecommendations: aggregated.globalRecommendations,
          },
        });

        this.logger.log(`[${scanId}] 🎉 ANALYSIS COMPLETED - ${scannedCount}/${apps.length} apps in ${duration}ms`);
      } catch (error: any) {
        this.logger.error(`[${scanId}] 💥 CRITICAL ERROR in background analysis: ${error.message}`);
        this.logger.error(`[${scanId}] Stack trace: ${error.stack}`);

        // Mettre à jour le status à 'failed'
        try {
          await this.scanRepository.update(scanId, {
            status: 'failed',
            completedAt: new Date(),
            errorMessage: error.message,
          });
        } catch (updateError: any) {
          this.logger.error(
            `[${scanId}] Failed to update scan status to failed: ${updateError.message}`,
          );
        }
      }
    });
  }

  private async scanApp(packageName: string): Promise<AnalysisResultDto> {
    const cacheKey = `scan:${packageName}`;
    const cached = await this.cacheService.get<AnalysisResultDto>(cacheKey);
    if (cached) {
      return cached;
    }

    try {
      const storeDataKey = `store:${packageName}`;
      let storeData = await this.cacheService.get(storeDataKey);
      if (!storeData) {
        storeData = await this.playStoreService.fetchAppDetails(packageName);
        await this.cacheService.set(storeDataKey, storeData, 86400);
      }

      const permissions = await this.playStoreService.fetchAppPermissions(packageName);

      const mobsfReport = {
        trackers: {
          'Google Firebase': { className: 'com.google.firebase.*' },
          'Google Analytics': { className: 'com.google.analytics.*' },
        },
      };

      const appInfo = JSON.stringify({
        packageName,
        permissions,
        storeData: storeData || {},
      }).substring(0, 2000);

      const aiAnalysis = await this.ollamaService.analyzeAppSecurity(appInfo);

      const { aiRiskScore, aiRiskLevel } = this.scoreCalculator.calculateRiskScore(
        permissions,
        mobsfReport.trackers || {},
        aiAnalysis.summary,
      );

      const result: AnalysisResultDto = {
        aiRiskScore,
        aiRiskLevel,
        aiSummary: aiAnalysis.summary,
        aiRecommendations: aiAnalysis.recommendations,
        permissions: permissions.map(p => ({ name: p })),
        trackers: Object.keys(mobsfReport.trackers || {}).map(t => ({ name: t })),
      };

      await this.cacheService.set(cacheKey, result, 3600);
      return result;
    } catch (error: any) {
      this.logger.error(`Scan error for ${packageName}: ${error.message}`);
      throw error;
    }
  }
}
